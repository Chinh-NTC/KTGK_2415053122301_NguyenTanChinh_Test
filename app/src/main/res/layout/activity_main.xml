<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <EditText
        android:id="@+id/edtTenKhoanChi_301"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên khoản chi"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/edtSoTien_301"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số tiền"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/edtGhiChu_301"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập ghi chú"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnThemKhoanChi_301"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm khoản chi"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnXemChiTiet_301"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem chi tiết khoản chi"/>
    </LinearLayout>
